# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
APP_NAME=invest-chat
HOST=0.0.0.0
PORT=8000

# Dev only — set to true only in development; never in production
RELOAD=false

# RAG & ChromaDB Configuration
CHROMADB_PATH=./chromadb
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.2

# CORS — comma-separated list of allowed origins
# Example: https://yourdomain.com,http://localhost:3000
CORS_ORIGINS=http://localhost:8000

# Admin API key — required to call POST /api/index (re-indexing endpoint)
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your_admin_api_key_here
