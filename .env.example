# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
APP_NAME=sales-assistant
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///./sales_assistant.db
CHROMA_DB_PATH=./chromadb

# Email Configuration
EMAIL=your_email@gmail.com
EMAIL_RECEIVER=info@ludekkvapil.cz
EMAIL_PWD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# AI Model Configuration
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.0
MAX_TOKENS=2000
CONTEXT_WINDOW=3
MAX_HISTORY=5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]

# Development
RELOAD=true
LOG_REQUESTS=true

# MCP (Model Context Protocol) Configuration
APIFY_API_KEY=your_apify_api_key_here
ENABLE_MCP=true
MCP_TIMEOUT=60
MCP_MAX_CONCURRENT_REQUESTS=5
MCP_ENABLE_CACHING=true
MCP_CACHE_TTL=3600

# Microsoft Teams Bot Configuration
TEAMS_BOT_ID=your_teams_bot_id_here
TEAMS_BOT_PASSWORD=your_teams_bot_password_here
TEAMS_BOT_HOST=0.0.0.0
TEAMS_BOT_PORT=3978
TEAMS_APP_ID=your_teams_app_id_here
