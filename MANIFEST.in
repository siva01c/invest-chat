# Include documentation files
include README.md
include CHANGELOG.md
include LICENSE
include .env.example

# Include configuration files
include pyproject.toml
include pytest.ini
# Requirements now in pyproject.toml only

# Include package data
recursive-include src/assistant/data/prompts *.md
recursive-include src/assistant/data/datasources *.json *.jsonl
recursive-include src/assistant/data/translations *.yml
recursive-include src/assistant/data/vocabulary *.txt
recursive-include src/assistant/data *.yml
recursive-include static *
recursive-include templates *

# Include test files
recursive-include tests *.py
recursive-include tests *.json
recursive-include tests *.yaml
recursive-include tests *.yml

# Include documentation
recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.txt
recursive-include docs *.png
recursive-include docs *.jpg
recursive-include docs *.svg

# Exclude development files
exclude .gitignore
exclude Makefile
exclude *.log
exclude .env
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * *.orig
recursive-exclude * *.rej
recursive-exclude * .DS_Store
recursive-exclude chromadb *
recursive-exclude logs *
